{
  "name": "screendocs",
  "version": "0.1.0",
  "description": "Automatically screenshot, record and document every screen of a website, including pages behind login.",
  "type": "module",
  "bin": {
    "screendocs": "bin/screendocs.mjs"
  },
  "files": ["bin", "src", "README.md", "README.pt-BR.md", "README.es.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "keywords": ["mcp", "screenshot", "documentation", "playwright", "portfolio", "crawler", "website"],
  "author": "Rubens Mota",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RuBeNsMoTa13/screendocs.git"
  },
  "homepage": "https://github.com/RuBeNsMoTa13/screendocs#readme",
  "scripts": {
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "manual:images": "node scripts/manual-images.mjs"
  },
  "dependencies": {
    "@clack/core": "0.5.0",
    "@clack/prompts": "0.11.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "jszip": "3.10.2",
    "picocolors": "1.1.1",
    "playwright-core": "1.56.1",
    "unpdf": "1.3.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  }
}
